{
  "name": "webcron",
  "version": "0.1.0",
  "private": true,
  "description": "웹으로 관리하는 크론 서버 (CLI·웹훅 작업 실행, 실행 이력, 감사 로그)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "node --test --test-concurrency=1 \"server/test/**/*.test.ts\"",
    "typecheck": "tsc -p server/tsconfig.json && svelte-check --tsconfig web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "zod": "3.25"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
